{
  "extends": "./base.json",
  "compilerOptions": {
    // Nest 12 ships ESM while the server itself is emitted as CommonJS; Node
    // resolves that at runtime, TypeScript only agrees under classic resolution.
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "ignoreDeprecations": "6.0",
    "target": "ES2023",
    "lib": ["ES2023"],
    "isolatedModules": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false
  }
}
