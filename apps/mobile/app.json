{
  "expo": {
    "name": "P2P Local",
    "slug": "p2p-local",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "p2plocal",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon.png",
    "primaryColor": "#0f7f4d",
    "backgroundColor": "#ffffff",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.codeforsenegal.p2plocal",
      "infoPlist": {
        "NSCameraUsageDescription": "L'application utilise l'appareil photo pour la photo de votre annonce.",
        "NSPhotoLibraryUsageDescription": "L'application acc\u00e8de \u00e0 vos photos pour illustrer votre annonce."
      }
    },
    "android": {
      "package": "org.codeforsenegal.p2plocal",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f7f4d"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'application acc\u00e8de \u00e0 vos photos pour illustrer votre annonce.",
          "cameraPermission": "L'application utilise l'appareil photo pour la photo de votre annonce."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "7581d9ef-a4ca-4a3b-b19e-947c45d4a2b4"
      }
    }
  }
}
