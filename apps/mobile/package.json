{
  "name": "@p2p-local/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform ios --platform android --output-dir dist",
    "lint": "eslint app components features lib providers stores",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "assets:build": "python3 scripts/build-app-assets.py",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@p2p-local/config": "workspace:*",
    "@p2p-local/design-tokens": "workspace:*",
    "@p2p-local/types": "workspace:*",
    "@p2p-local/validation": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.102.8",
    "expo": "^57.0.23",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.0",
    "expo-file-system": "~57.0.7",
    "expo-image": "~57.0.0",
    "expo-image-picker": "~57.0.0",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.0",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.22",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@p2p-local/eslint-config": "workspace:*",
    "@p2p-local/typescript-config": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.18",
    "eslint": "^10.10.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
