  "info": {
    "title": "Wantere API",
    "description": "Local commerce and exchange platform",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+221770000000"
          },
          "displayName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60,
            "example": "Awa Diop"
          }
        },
        "required": [
          "phone",
          "displayName"
        ]
      },
      "OtpChallengeDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Only returned outside production"
          }
        },
        "required": [
          "phone",
          "expiresAt"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+221770000000"
          }
        },
        "required": [
          "phone"
        ]
      },
      "VerifyOtpDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+221770000000"
          },
          "code": {
            "type": "string",
            "minLength": 6,
            "maxLength": 6,
            "pattern": "^\\d+$",
            "example": "123456"
          },
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android",
              "web"
            ]
          },
          "deviceName": {
            "type": "string",
            "maxLength": 80,
            "example": "Pixel 8"
          }
        },
        "required": [
          "phone",
          "code"
        ]
      },
      "AuthTokensDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresIn"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "maxLength": 512
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "SessionUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "phone",
          "role",
          "status",
          "displayName",
          "avatarUrl"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "bio": {
            "type": "string",
            "maxLength": 500
          },
          "city": {
            "type": "string",
            "maxLength": 80
          },
          "avatarKey": {
            "type": "string",
            "maxLength": 255
          }
        }
      },
      "CreateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "parentId": {
            "type": "string",
            "format": "uuid"
          },
          "icon": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "sortOrder": {
            "type": "number",
            "minimum": 0,
            "default": 0
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "icon": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "sortOrder": {
            "type": "number",
            "minimum": 0
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "CreateListingDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "type": {
            "enum": [
              "SALE",
              "DONATION",
              "BARTER",
              "REQUEST"
            ],
            "type": "string"
          },
          "condition": {
            "enum": [
              "NEW",
              "LIKE_NEW",
              "GOOD",
              "FAIR",
              "POOR"
            ],
            "type": "string"
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000,
            "description": "Required for a sale, in minor-free XOF units"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "latitude": {
            "type": "number",
            "example": 14.6928
          },
          "longitude": {
            "type": "number",
            "example": -17.4467
          },
          "city": {
            "type": "string",
            "maxLength": 80,
            "example": "Dakar"
          },
          "district": {
            "type": "string",
            "maxLength": 80,
            "example": "Medina"
          },
          "mediaKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "title",
          "description",
          "type",
          "categoryId",
          "latitude",
          "longitude"
        ]
      },
      "UpdateListingDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "condition": {
            "enum": [
              "NEW",
              "LIKE_NEW",
              "GOOD",
              "FAIR",
              "POOR"
            ],
            "type": "string"
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000,
            "description": "Required for a sale, in minor-free XOF units"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "latitude": {
            "type": "number",
            "example": 14.6928
          },
          "longitude": {
            "type": "number",
            "example": -17.4467
          },
          "city": {
            "type": "string",
            "maxLength": 80,
            "example": "Dakar"
          },
          "district": {
            "type": "string",
            "maxLength": 80,
            "example": "Medina"
          },
          "status": {
            "enum": [
              "ACTIVE",
              "RESERVED",
              "COMPLETED",
              "ARCHIVED"
            ],
            "type": "string"
          }
        }
      },
      "AddFavoriteDto": {
        "type": "object",
        "properties": {
          "listingId": {
            "type": "string"
          }
        },
        "required": [
          "listingId"
        ]
      },
      "CreateReportDto": {
        "type": "object",
        "properties": {
          "targetType": {
            "enum": [
              "USER",
              "LISTING"
            ],
            "type": "string"
          },
          "targetId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "enum": [
              "FRAUD",
              "SPAM",
              "PROHIBITED_ITEM",
              "HARASSMENT",
              "MISLEADING",
              "DUPLICATE",
              "OTHER"
            ],
            "type": "string"
          },
          "comment": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "targetType",
          "targetId",
          "reason"
        ]
      },
      "ReviewReportDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "RESOLVED",
              "DISMISSED"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}